# MongoDB connection string (required)
# Example: mongodb+srv://user:password@cluster.mongodb.net/godino-blog
MONGODB_URI=

# Blog admin token: used as Bearer token for all /api/blog/admin/* endpoints
BLOG_ADMIN_TOKEN=

# SMTP config for contact form emails
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TO=

# Pushover notifications (optional)
PUSHOVER_TOKEN=
PUSHOVER_USER=

# ─── Site ───
# URL publique, sans barre finale. Utilisée pour canonical, sitemap, Open Graph,
# JSON-LD. Doit être disponible au build (Coolify : "Build variable").
# Aujourd'hui : https://www.creation-sites-godino.fr
# Au changement de domaine : https://www.lanterneweb.fr
SITE_URL=https://www.creation-sites-godino.fr

# Email affiché sur le site.
# Aujourd'hui : contact@creation-sites-godino.fr
# Au changement de domaine : contact@lanterneweb.fr
SITE_EMAIL=contact@creation-sites-godino.fr

# Redirection 301, page par page, de creation-sites-godino.fr (avec et sans www)
# et de lanterneweb.fr (sans www) vers https://www.lanterneweb.fr.
# Laisser vide tant que lanterneweb.fr n'est pas actif. Lu au build.
REDIRECT_TO_NEW_DOMAIN=

# Destinataire des messages du formulaire de contact (sinon SMTP_USER).
CONTACT_EMAIL=

# Secret de signature du jeton anti-robots du formulaire (sinon BLOG_ADMIN_TOKEN).
# Doit rester stable entre redémarrages. Ex : openssl rand -hex 32
FORM_GUARD_SECRET=

# Google Search Console (code de la balise meta, optionnel)
GOOGLE_SITE_VERIFICATION=

# ─── Mentions légales : Éditeur ───
NEXT_PUBLIC_LEGAL_STATUT=
NEXT_PUBLIC_LEGAL_SIRET=
NEXT_PUBLIC_LEGAL_TVA=
NEXT_PUBLIC_LEGAL_ADRESSE=

# ─── Mentions légales : Hébergeur ───
NEXT_PUBLIC_HOST_NAME=
NEXT_PUBLIC_HOST_ADDRESS=
NEXT_PUBLIC_HOST_WEBSITE=
NEXT_PUBLIC_HOST_PHONE=
